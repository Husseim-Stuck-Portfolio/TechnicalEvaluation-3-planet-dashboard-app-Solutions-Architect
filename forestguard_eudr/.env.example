# Copy to .env and fill in. NEVER commit a real .env.
# The app runs fully without any of these (sample-data mode).

# Planet account API key (Insights Platform trial is sufficient for sandbox data)
PLANET_API_KEY=

# Subscriptions API endpoint (leave default unless directed otherwise)
PLANET_SUBSCRIPTIONS_URL=https://api.planet.com/subscriptions/v1

# Forest Carbon Monitoring BYOC collection ids (from Planet Docs > Sandbox Data)
PLANET_CANOPY_COVER_SOURCE_ID=
PLANET_CANOPY_HEIGHT_SOURCE_ID=
PLANET_CARBON_SOURCE_ID=

# Optional: GeoJSON file with the AOI for Planet mode
PLANET_AOI_FILE=
